# Operator details for the legal pages (Impressum / Datenschutz).
#
# These are injected into the build so your real name/address/contact never get
# committed to the (public) repo. Copy this file to `.env.local` (gitignored)
# for local builds, and set the same variables in:
#   Cloudflare Pages → your project → Settings → Environment variables.
#
# Note: an Impressum must be publicly visible, so these values DO appear on the
# deployed /impressum page and in the shipped JS. This only keeps them out of
# the git repository — it is not a place for true secrets.
#
# Must be prefixed with VITE_ to be exposed to the client build (Vite).

VITE_LEGAL_NAME="Vorname Nachname"
VITE_LEGAL_STREET="Straße und Hausnummer"
VITE_LEGAL_CITY="PLZ Stadt"
VITE_LEGAL_COUNTRY="Germany"
VITE_LEGAL_EMAIL="you@example.com"
# Optional — leave empty to omit the phone line from the Impressum.
VITE_LEGAL_PHONE=""
