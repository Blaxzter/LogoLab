# dependencies
node_modules
.pnpm-store

# build output
dist
dist-ssr
*.local

# local env files — operator details (Impressum/Datenschutz) live here; never
# commit real values. The committed template is .env.example (see below).
.env
.env.*
!.env.example

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# test / automation artifacts (Playwright writes screenshots here)
.playwright-mcp/

# raw dropped-in source images (the deployed copies live in public/mockups/)
/assets/

# reference papers kept locally, not committed
/examples/*.pdf

# private ground-truth logo corpus — the brand-mark artwork itself is NOT
# redistributed here (trademark/copyright). Only the manifest + fetcher are
# tracked; run `npm run fetch:logos` to rehydrate the .svg files on demand.
/examples/logos/*.svg

# local real-world repro images (user-supplied, possibly trademarked artwork —
# same policy as examples/logos: referenced from docs (§0 #13) but not redistributed)
/examples/test-files/

# generated dev-harness artifacts (crispnessStudy/facetSweep/paletteCompare output)
/crispness-study/

# vendored-corpus download cache (src/devtest/vendorFluentEmoji.ts)
/.cache/
