{
  "name": "logolab",
  "version": "0.1.0",
  "description": "MCP server for LogoLab: trace an image to a clean SVG and export a full app-icon set, locally, from your coding agent.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "svg",
    "vectorize",
    "trace",
    "favicon",
    "pwa",
    "icons",
    "logo"
  ],
  "homepage": "https://github.com/Blaxzter/LogoLab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blaxzter/LogoLab.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/Blaxzter/LogoLab/issues",
  "license": "MIT",
  "author": "Frederic Abraham",
  "type": "module",
  "bin": {
    "logolab": "dist/mcp/server.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "esm-potrace-wasm": "^0.4.1",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "sharp": "^0.34.5"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
