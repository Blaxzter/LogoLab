{
  "name": "logolab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Drop in a logo, preview it in real-world contexts, vectorize to clean SVG, and export PWA-ready icons.",
  "homepage": "https://github.com/Blaxzter/LogoLab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blaxzter/LogoLab.git"
  },
  "bugs": {
    "url": "https://github.com/Blaxzter/LogoLab/issues"
  },
  "scripts": {
    "dev": "vite",
    "gen:previews": "node src/devtest/genControlPreviews.ts",
    "build": "node scripts/gen-previews.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test",
    "gen:golden": "node src/devtest/writeTraceGolden.ts",
    "gen:absnapshot": "node src/devtest/writeAbSnapshots.ts",
    "fetch:logos": "node scripts/fetch-logos.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "esm-potrace-wasm": "^0.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
